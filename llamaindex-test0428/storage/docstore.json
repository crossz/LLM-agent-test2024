{"docstore/metadata": {"19f99305-36da-414a-b72f-a03556e0c681": {"doc_hash": "a0e37753e3165a4d5266243f252acfb93cd3dd4376ae9a2a06506bbf8829b914"}, "351085bc-8b97-404d-b135-8889f0f0890c": {"doc_hash": "da8cd7c5f7c086e058af68d96a060796092218c133cab096260de9e96f3ebf00", "ref_doc_id": "19f99305-36da-414a-b72f-a03556e0c681"}}, "docstore/data": {"351085bc-8b97-404d-b135-8889f0f0890c": {"__data__": {"id_": "351085bc-8b97-404d-b135-8889f0f0890c", "embedding": null, "metadata": {"file_path": "/workspaces/LLM-agent-test2024/test0428/data/test1.txt", "file_name": "test1.txt", "file_type": "text/plain", "file_size": 2750, "creation_date": "2025-04-28", "last_modified_date": "2025-04-28"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "19f99305-36da-414a-b72f-a03556e0c681", "node_type": "4", "metadata": {"file_path": "/workspaces/LLM-agent-test2024/test0428/data/test1.txt", "file_name": "test1.txt", "file_type": "text/plain", "file_size": 2750, "creation_date": "2025-04-28", "last_modified_date": "2025-04-28"}, "hash": "a0e37753e3165a4d5266243f252acfb93cd3dd4376ae9a2a06506bbf8829b914", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u6211\u73b0\u5728\u9700\u8981\u5e2e\u7528\u6237\u521b\u5efa\u4e00\u4e2a\u57fa\u4e8eLlamaIndex v0.12\u7684\u6f14\u793a\u7a0b\u5e8f\u3002\u9996\u5148\uff0c\u6211\u5f97\u56de\u987e\u4e00\u4e0b\u7528\u6237\u4e4b\u524d\u7684\u95ee\u9898\u548c\u641c\u7d22\u7ed3\u679c\uff0c\u770b\u770b\u6709\u54ea\u4e9b\u53ef\u4ee5\u53c2\u8003\u7684\u4fe1\u606f\u3002\u7528\u6237\u4e4b\u524d\u95ee\u8fc7\u5982\u4f55\u5c06\u65e7\u4ee3\u7801\u9002\u914d\u5230v0.12\uff0c\u73b0\u5728\u9700\u8981\u7684\u662f\u4e00\u4e2a\u5168\u65b0\u7684demo\u3002\n\n\u9996\u5148\uff0c\u6211\u5e94\u8be5\u68c0\u67e5LlamaIndex v0.12\u7684\u5b98\u65b9\u6587\u6863\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u641c\u7d22\u7ed3\u679c\uff0c\u6bd4\u59821\u30012\u548c7\u4e2d\u7684\u5185\u5bb9\uff0c\u8fd9\u4e9b\u8d44\u6e90\u63d0\u5230\u4e86\u4f7f\u7528SimpleDirectoryReader\u52a0\u8f7d\u6570\u636e\u3001\u521b\u5efa\u7d22\u5f15\u4ee5\u53ca\u67e5\u8be2\u5f15\u64ce\u7684\u57fa\u672c\u6b65\u9aa4\u3002\u4f8b\u5982\uff0c7\u4e2d\u7684\u4ee3\u7801\u793a\u4f8b\u4f7f\u7528\u4e86VectorStoreIndex\u548c\u67e5\u8be2\u5f15\u64ce\uff0c\u8fd9\u53ef\u80fd\u662f\u65b0\u7248\u672c\u7684\u6807\u51c6\u505a\u6cd5\u3002\n\n\u63a5\u4e0b\u6765\uff0c\u6211\u9700\u8981\u786e\u8ba4v0.12\u4e2d\u7684\u6a21\u5757\u7ed3\u6784\u3002\u5728\u4e4b\u524d\u7684\u56de\u7b54\u4e2d\uff0c\u7528\u6237\u63d0\u5230\u7c7b\u540d\u548c\u5bfc\u5165\u8def\u5f84\u7684\u53d8\u5316\uff0c\u6bd4\u5982GPTListIndex\u6539\u4e3aListIndex\uff0c\u4f46\u73b0\u5728\u53ef\u80fd\u9700\u8981\u7528VectorStoreIndex\uff0c\u56e0\u4e3a7\u4e2d\u7684\u793a\u4f8b\u4f7f\u7528\u4e86\u5b83\u3002\u6b64\u5916\uff0c\u8bbe\u7f6e\u5168\u5c40ServiceContext\u7684\u65b9\u6cd5\u53ef\u80fd\u4ecd\u7136\u9002\u7528\uff0c\u5982\u4f7f\u7528set_global_service_context\u3002\n\n\u7136\u540e\uff0c\u8003\u8651\u6570\u636e\u52a0\u8f7d\u90e8\u5206\u3002SimpleDirectoryReader\u4ecd\u7136\u9002\u7528\uff0c\u59821\u30012\u548c7\u4e2d\u6240\u793a\u3002\u9700\u8981\u786e\u4fdd\u6570\u636e\u76ee\u5f55\u6b63\u786e\uff0c\u5e76\u5904\u7406\u4e0d\u540c\u6587\u4ef6\u683c\u5f0f\u7684\u652f\u6301\u3002\n\n\u5173\u4e8e\u6a21\u578b\u914d\u7f6e\uff0c\u7528\u6237\u4e4b\u524d\u4f7f\u7528\u4e86OpenAILike\u548c\u4e0d\u540c\u7684API\u7aef\u70b9\uff0c\u6bd4\u5982\u767e\u5ea6\u6216SiliconFlow\u3002\u5728demo\u4e2d\uff0c\u53ef\u80fd\u9700\u8981\u4f7f\u7528OpenAI\u7684\u9ed8\u8ba4\u8bbe\u7f6e\uff0c\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c55\u793a\u5982\u4f55\u81ea\u5b9a\u4e49\uff0c\u6bd4\u5982\u8bbe\u7f6eapi_base\u548capi_key\uff0c\u59822\u4e2d\u7684\u793a\u4f8b\u3002\u4e0d\u8fc7\uff0c\u4e3a\u4e86\u7b80\u5316demo\uff0c\u53ef\u80fd\u4f7f\u7528\u9ed8\u8ba4\u7684OpenAI\u6a21\u578b\uff0c\u5e76\u63d0\u793a\u7528\u6237\u66ff\u6362API\u5bc6\u94a5\u3002\n\n\u7136\u540e\uff0c\u6784\u5efa\u7d22\u5f15\u90e8\u5206\u3002v0.12\u4e2d\u521b\u5efa\u7d22\u5f15\u7684\u65b9\u5f0f\u53ef\u80fd\u6709\u6240\u4e0d\u540c\uff0c\u6bd4\u5982\u4f7f\u7528VectorStoreIndex.from_documents \uff0c\u5e76\u4f20\u5165ServiceContext\u3002\u9700\u8981\u786e\u4fdd\u6b63\u786e\u5bfc\u5165ServiceContext\u548cLLM\u76f8\u5173\u6a21\u5757\uff0c\u5982OpenAI\u6216\u81ea\u5b9a\u4e49\u7684\u7c7b\u3002\n\n\u67e5\u8be2\u5f15\u64ce\u7684\u521b\u5efa\u548c\u67e5\u8be2\u6b65\u9aa4\u57287\u4e2d\u6709\u793a\u4f8b\uff0c\u4f7f\u7528index.as_query_engine() \u548cquery_engine.query() \u65b9\u6cd5\u3002\u9700\u8981\u786e\u4fdd\u8fd9\u90e8\u5206\u4ee3\u7801\u6b63\u786e\uff0c\u5e76\u5904\u7406\u54cd\u5e94\u8f93\u51fa\u3002\n\n\u53e6\u5916\uff0c\u4fdd\u5b58\u548c\u52a0\u8f7d\u7d22\u5f15\u7684\u529f\u80fd\u53ef\u80fd\u5bf9\u7528\u6237\u6709\u7528\uff0c\u59823\u4e2d\u63d0\u5230\u7684\u4fdd\u5b58\u5230\u78c1\u76d8\u3002\u53ef\u4ee5\u5728demo\u4e2d\u52a0\u5165\u8fd9\u90e8\u5206\uff0c\u5c55\u793a\u5982\u4f55\u6301\u4e45\u5316\u7d22\u5f15\u3002\n\n\u8fd8\u9700\u8981\u6ce8\u610f\u9519\u8bef\u5904\u7406\uff0c\u6bd4\u5982\u7f51\u7edc\u8fde\u63a5\u95ee\u9898\u6216API\u5bc6\u94a5\u9519\u8bef\uff0c\u59821\u548c6\u4e2d\u63d0\u5230\u7684\u3002\u5728demo\u4e2d\u52a0\u5165try-except\u5757\u6216\u63d0\u793a\u7528\u6237\u68c0\u67e5\u8fd9\u4e9b\u70b9\u53ef\u80fd\u6709\u52a9\u4e8e\u7528\u6237\u4f53\u9a8c\u3002\n\n\u6700\u540e\uff0c\u7efc\u5408\u591a\u4e2a\u641c\u7d22\u7ed3\u679c\u7684\u4fe1\u606f\uff0c\u6bd4\u59824\u548c8\u4e2d\u5173\u4e8eLlamaIndex\u7684\u57fa\u672c\u6982\u5ff5\u548c\u5b89\u88c5\u6b65\u9aa4\uff0c\u786e\u4fdddemo\u5305\u542b\u5fc5\u8981\u7684\u5b89\u88c5\u8bf4\u660e\u548c\u73af\u5883\u8bbe\u7f6e\u3002\n\n\u73b0\u5728\uff0c\u6211\u9700\u8981\u5c06\u8fd9\u4e9b\u6b65\u9aa4\u6574\u5408\u6210\u4e00\u4e2a\u7b80\u6d01\u7684\u793a\u4f8b\u4ee3\u7801\uff0c\u786e\u4fdd\u6240\u6709\u5bfc\u5165\u6b63\u786e\uff0c\u4f7f\u7528v0.12\u7684API\uff0c\u5e76\u5305\u542b\u5fc5\u8981\u7684\u6ce8\u91ca\u548c\u9519\u8bef\u5904\u7406\u3002\u540c\u65f6\uff0c\u53c2\u8003\u7528\u6237\u5386\u53f2\u5bf9\u8bdd\u4e2d\u7684\u4ee3\u7801\u7ed3\u6784\uff0c\u786e\u4fdd\u98ce\u683c\u4e00\u81f4\u3002\u53ef\u80fd\u8fd8\u9700\u8981\u6d4b\u8bd5\u4ee3\u7801\u7247\u6bb5\uff0c\u786e\u4fdd\u6ca1\u6709\u8bed\u6cd5\u9519\u8bef\u6216\u8fc7\u65f6\u7684\u65b9\u6cd5\u3002", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1210, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/ref_doc_info": {"19f99305-36da-414a-b72f-a03556e0c681": {"node_ids": ["351085bc-8b97-404d-b135-8889f0f0890c"], "metadata": {"file_path": "/workspaces/LLM-agent-test2024/test0428/data/test1.txt", "file_name": "test1.txt", "file_type": "text/plain", "file_size": 2750, "creation_date": "2025-04-28", "last_modified_date": "2025-04-28"}}}}